{
  "name": "Sell Guy",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "runServices": ["postgres", "workspace"],
  "workspaceFolder": "/workspaces/sell-guy",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "forwardPorts": [4200, 8080],
  "portsAttributes": {
    "4200": { "label": "Sell Guy web" },
    "8080": { "label": "Sell Guy API" }
  },
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "profile": "minimal",
      "components": "rustfmt,clippy"
    }
  },
  "postCreateCommand": "pnpm install --frozen-lockfile && pnpm db:migrate",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "dbaeumer.vscode-eslint"]
    }
  }
}
