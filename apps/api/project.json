{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo run --locked --manifest-path apps/api/Cargo.toml -- serve", "cwd": "." }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/api/target/release/sell-guy-api"],
      "options": { "command": "cargo build --locked --release --manifest-path apps/api/Cargo.toml", "cwd": "." }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo test --locked --manifest-path apps/api/Cargo.toml", "cwd": "." }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo fmt --manifest-path apps/api/Cargo.toml --check && cargo check --locked --manifest-path apps/api/Cargo.toml --all-targets", "cwd": "." }
    }
  }
}
